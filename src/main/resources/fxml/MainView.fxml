<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.karaik.spmviewer.controller.MainViewController">

    <top>
        <VBox spacing="4">
            <MenuBar>
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem text="Open Directory..." onAction="#onOpenDirectory"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Export Canvas as PNG…" onAction="#onExportPng"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Quit" onAction="#onQuit"/>
                        </items>
                    </Menu>
                    <Menu text="Settings">
                        <items>
                            <MenuItem text="Charset..." onAction="#onShowCharsetSettings"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="Shortcuts" onAction="#onShowShortcuts"/>
                            <MenuItem text="About" onAction="#onAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <CheckBox fx:id="alwaysOnTopCheck" text="Always on Top"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Zoom:"/>
                <Slider fx:id="zoomSlider" min="0.1" max="8.0" value="1.0" prefWidth="120"/>
                <TextField fx:id="zoomField" prefWidth="60"/>
                <Button text="100%" onAction="#onZoom1x"/>
                <Button text="Fit" onAction="#onFit"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Anim:"/>
                <ComboBox fx:id="animSelector" prefWidth="180"/>
                <Button text="▶" onAction="#onPlay"/>
                <Button text="⏹" onAction="#onStop"/>
                <Label text="FPS:"/>
                <Slider fx:id="fpsSlider" min="1" max="60" value="2" prefWidth="100"/>
                <TextField fx:id="fpsField" prefWidth="50"/>

                <Pane HBox.hgrow="ALWAYS"/> <!-- Spacer -->

                <Button text="Export PNG" onAction="#onExportPng"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.2, 0.75" BorderPane.alignment="CENTER">
            <items>
                <VBox prefWidth="250.0" minWidth="180">
                    <children>
                        <TextField fx:id="searchField" promptText="Search files...">
                            <VBox.margin>
                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
                            </VBox.margin>
                        </TextField>
                        <SplitPane dividerPositions="0.4" orientation="VERTICAL" VBox.vgrow="ALWAYS">
                            <items>
                                <ListView fx:id="spmListView"/>
                                <Accordion>
                                    <panes>
                                        <TitledPane text="Pages">
                                            <content>
                                                <TreeView fx:id="pageTree"/>
                                            </content>
                                        </TitledPane>
                                        <!-- MODIFICATION START: Added search field for animations -->
                                        <TitledPane fx:id="animTitledPane" text="Animations">
                                            <content>
                                                <VBox spacing="4">
                                                    <children>
                                                        <TextField fx:id="animSearchField" promptText="Search animations..."/>
                                                        <TreeView fx:id="animTree"/>
                                                    </children>
                                                    <padding>
                                                        <Insets topRightBottomLeft="4"/>
                                                    </padding>
                                                </VBox>
                                            </content>
                                        </TitledPane>
                                        <!-- MODIFICATION END -->
                                        <TitledPane text="Images">
                                            <content>
                                                <ListView fx:id="imageList"/>
                                            </content>
                                        </TitledPane>
                                    </panes>
                                </Accordion>
                            </items>
                        </SplitPane>
                    </children>
                </VBox>

                <ScrollPane fx:id="scrollPane" pannable="true" fitToWidth="true" fitToHeight="true">
                    <content>
                        <StackPane fx:id="canvasHolder">
                            <padding>
                                <Insets topRightBottomLeft="8"/>
                            </padding>
                        </StackPane>
                    </content>
                </ScrollPane>

                <VBox spacing="8" minWidth="200">
                    <TabPane fx:id="rightTabs" tabClosingPolicy="UNAVAILABLE" prefWidth="420" VBox.vgrow="ALWAYS">
                        <tabs>
                            <Tab text="Chips">
                                <content>
                                    <TableView fx:id="chipTable">
                                        <placeholder><Label text="No chips"/></placeholder>
                                        <columns>
                                            <TableColumn text="Img #" prefWidth="50">
                                                <cellValueFactory><PropertyValueFactory property="imageNo" /></cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Dst Rect" prefWidth="150">
                                                <cellValueFactory><PropertyValueFactory property="dstRect" /></cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Src Rect" prefWidth="150">
                                                <cellValueFactory><PropertyValueFactory property="srcRect" /></cellValueFactory>
                                            </TableColumn>
                                        </columns>
                                    </TableView>
                                </content>
                            </Tab>
                            <Tab text="Hit Areas">
                                <content>
                                    <TableView fx:id="hitTable">
                                        <placeholder><Label text="No hit areas"/></placeholder>
                                        <columns>
                                            <!-- 绑定到通用的 ID -->
                                            <TableColumn text="ID" prefWidth="50">
                                                <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                                            </TableColumn>
                                            <!-- 绑定到通用的形状类型 -->
                                            <TableColumn text="Type" prefWidth="50">
                                                <cellValueFactory><PropertyValueFactory property="shapeType" /></cellValueFactory>
                                            </TableColumn>
                                            <!-- 绑定到 getDisplayInfo() 方法 -->
                                            <TableColumn text="Desc" prefWidth="300">
                                                <cellValueFactory><PropertyValueFactory property="displayInfo" /></cellValueFactory>
                                            </TableColumn>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                </content>
                            </Tab>
                            <Tab text="Info">
                                <content>
                                    <ScrollPane fitToWidth="true">
                                        <content>
                                            <GridPane hgap="10" vgap="6">
                                                <padding>
                                                    <Insets topRightBottomLeft="10"/>
                                                </padding>
                                                <children>
                                                    <Label text="SPM Version:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                                    <Label fx:id="lblVersion" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                                    <Label text="Pages:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                                    <Label fx:id="lblPages" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                    <Label text="Images:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                                    <Label fx:id="lblImages" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                                    <Label text="Animations:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                                    <Label fx:id="lblAnims" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                                </children>
                                            </GridPane>
                                        </content>
                                    </ScrollPane>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets topRightBottomLeft="8"/>
            </padding>
            <children>
                <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS"/>
                <ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0" visible="false"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>