<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.karaik.spmviewer.controller.MainViewController">

    <top>
        <VBox spacing="4">
            <MenuBar>
                <menus>
                    <Menu text="File">
                        <items>
                            <!-- MODIFIED: Changed menu items -->
                            <MenuItem text="Open Directory..." onAction="#onOpenDirectory"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Export Canvas as PNG…" onAction="#onExportPng"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Quit" onAction="#onQuit"/>
                        </items>
                    </Menu>
                    <Menu text="View">
                        <items>
                            <CheckMenuItem text="Show Page Rect" selected="true" fx:id="miShowPageRect"/>
                            <CheckMenuItem text="Show Hit Areas" selected="true" fx:id="miShowHit"/>
                            <CheckMenuItem text="Show Chip Bounds" fx:id="miShowChipBounds"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="About" onAction="#onAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <Label text="Page:"/>
                <Spinner fx:id="pageSpinner" editable="true" prefWidth="100"/>

                <Separator orientation="VERTICAL"/>

                <ToggleButton fx:id="tbShowPageRect" text="Page Rect" selected="true"/>
                <ToggleButton fx:id="tbShowHit" text="Hit" selected="true"/>
                <ToggleButton fx:id="tbShowChipBounds" text="Chip"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Zoom:"/>
                <Slider fx:id="zoomSlider" min="0.1" max="8.0" value="1.0" prefWidth="160"/>
                <Button text="100% (1x)" onAction="#onZoom1x"/>
                <Button text="Fit" onAction="#onFit"/>
                <Button text="Export PNG" onAction="#onExportPng"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Anim:"/>
                <ComboBox fx:id="animSelector" prefWidth="200"/>
                <Button text="▶" onAction="#onPlay"/>
                <Button text="⏹" onAction="#onStop"/>
                <Label text="FPS:"/>
                <Slider fx:id="fpsSlider" min="5" max="60" value="30" prefWidth="120"/>
            </ToolBar>
        </VBox>
    </top>

    <left>
        <!-- MODIFIED: Replaced VBox with a SplitPane for top/bottom sections -->
        <SplitPane dividerPositions="0.4" orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <ListView fx:id="spmListView"/>
                <Accordion>
                    <panes>
                        <TitledPane text="Pages">
                            <content>
                                <VBox>
                                    <children>
                                        <TreeView fx:id="pageTree" VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                        <TitledPane text="Animations">
                            <content>
                                <VBox>
                                    <children>
                                        <TreeView fx:id="animTree" VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                        <TitledPane text="Images">
                            <content>
                                <VBox>
                                    <children>
                                        <ListView fx:id="imageList" VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                    </panes>
                </Accordion>
            </items>
        </SplitPane>
    </left>

    <center>
        <ScrollPane fx:id="scrollPane" pannable="true" fitToWidth="true" fitToHeight="true">
            <content>
                <StackPane fx:id="canvasHolder">
                    <padding>
                        <Insets topRightBottomLeft="8"/>
                    </padding>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <right>
        <VBox spacing="8" BorderPane.alignment="CENTER">
            <TabPane fx:id="rightTabs" tabClosingPolicy="UNAVAILABLE" prefWidth="420" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Chips">
                        <content>
                            <TableView fx:id="chipTable">
                                <placeholder>
                                    <Label text="No chips"/>
                                </placeholder>
                            </TableView>
                        </content>
                    </Tab>
                    <Tab text="Hit Areas">
                        <content>
                            <TableView fx:id="hitTable">
                                <placeholder>
                                    <Label text="No hit areas"/>
                                </placeholder>
                            </TableView>
                        </content>
                    </Tab>
                    <Tab text="Info">
                        <content>
                            <ScrollPane fitToWidth="true">
                                <content>
                                    <GridPane hgap="10" vgap="6">
                                        <padding>
                                            <Insets topRightBottomLeft="10"/>
                                        </padding>
                                        <children>
                                            <Label text="SPM Version:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                            <Label fx:id="lblVersion" text="-" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0"/>

                                            <Label text="Pages:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                            <Label fx:id="lblPages" text="-" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>

                                            <Label text="Images:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                            <Label fx:id="lblImages" text="-" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="2"/>

                                            <Label text="Animations:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                            <Label fx:id="lblAnims" text="-" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="3"/>
                                        </children>
                                    </GridPane>
                                </content>
                            </ScrollPane>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets topRightBottomLeft="8"/>
            </padding>
            <children>
                <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS"/>
                <!-- ADDED: ProgressBar for loading -->
                <ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0" visible="false"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>